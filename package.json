{
  "name": "virtual-campus",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "description": "赛博校园：可解释、可复现的校园微型生命模拟器。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/L8848-Li/VirtualCampus.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8765 --strictPort",
    "start": "vite --host 127.0.0.1 --port 8765 --strictPort",
    "check": "vue-tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:replay:full": "node scripts/test-full-replay.mjs",
    "test:watch": "vitest",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8765 --strictPort",
    "evaluate": "node --experimental-strip-types scripts/evaluate.ts"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
